# Copier en .env.prod (jamais versionné) et remplacer chaque valeur.
# Lancement : docker compose -f compose.prod.yaml --env-file .env.prod up -d

# Domaine public : Caddy obtient le certificat HTTPS pour ce nom.
# localhost pour un essai sur le poste.
DOMAINE=mecadetect.example.fr

# Version des images (étiquette GHCR) ; latest par défaut
VERSION=latest

# Compte administrateur d'Oracle (SYS, SYSTEM)
ORACLE_PASSWORD=a-remplacer

# Compte de l'application, créé au premier démarrage d'Oracle
ORACLE_APP_USER=mecadetect
ORACLE_APP_PASSWORD=a-remplacer

# Clé de signature des jetons : 32 octets aléatoires au moins, en Base64.
# Pour en générer une (PowerShell) :
#   $o = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($o); [Convert]::ToBase64String($o)
# ou (Linux) : openssl rand -base64 32
JWT_SECRET=a-remplacer